<?xml version="1.0" encoding="UTF-8"?>
<!-- Erzeugt von scripts/deploy.mjs – nicht von Hand bearbeiten -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6a9184d0-cfd5-4bd8-84c4-5eec8f28d457</Id>
  <Version>1.5.0.0</Version>
  <ProviderName>Andrej Chenfeld</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="MyMonolith Aufgaben"/>
  <Description DefaultValue="MyMonolith-Aufgaben in Outlook anzeigen, kommentieren und Mails an Aufgaben anhängen."/>
  <IconUrl DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://new.my-monolith.com/"/>
  <AppDomains>
    <AppDomain>https://new.my-monolith.com</AppDomain>
    <AppDomain>https://api.niki24.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://klynovyj.github.io/mymonolith-addin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://klynovyj.github.io/mymonolith-addin/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="mmGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="mmOpenPane">
                  <Label resid="BtnLabel"/>
                  <Supertip>
                    <Title resid="BtnLabel"/>
                    <Description resid="BtnDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://klynovyj.github.io/mymonolith-addin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="MyMonolith"/>
        <bt:String id="BtnLabel" DefaultValue="Aufgaben"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="BtnDesc" DefaultValue="Öffnet Ihre MyMonolith-Aufgaben in der Seitenleiste."/>
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Laufzeit für das Sende-Ereignis: HTML (neues Outlook / Web), JS (klassisches Outlook) -->
          <Runtimes>
            <Runtime resid="SendRuntime.Url">
              <Override type="javascript" resid="SendRuntimeJs.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mmGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="mmOpenPane">
                    <Label resid="BtnLabel"/>
                    <Supertip>
                      <Title resid="BtnLabel"/>
                      <Description resid="BtnDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl"/>
                      <!-- Seitenleiste bleibt beim Wechsel zwischen Mails offen -->
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Verfassen: Aufgabe wählen, an die die Mail beim Senden gepostet wird -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mmComposeGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="mmComposePane">
                    <Label resid="ComposeBtnLabel"/>
                    <Supertip>
                      <Title resid="ComposeBtnLabel"/>
                      <Description resid="ComposeBtnDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Beim Antworten: Aufgabe vorschlagen; beim Senden: Mail an die gewählten Aufgaben posten -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="SoftBlock"/>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewComposeHandler"/>
              </LaunchEvents>
              <SourceLocation resid="SendRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
          <!-- Outlook-App auf Handy/Tablet: Knopf beim Lesen einer Mail -->
          <MobileFormFactor>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="mmMobileGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="MobileButton" id="mmMobileOpen">
                  <Label resid="BtnLabel"/>
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="Icon25"/>
                    <bt:Image size="25" scale="2" resid="Icon50"/>
                    <bt:Image size="25" scale="3" resid="Icon75"/>
                    <bt:Image size="32" scale="1" resid="Icon32"/>
                    <bt:Image size="32" scale="2" resid="Icon64"/>
                    <bt:Image size="32" scale="3" resid="Icon96"/>
                    <bt:Image size="48" scale="1" resid="Icon48"/>
                    <bt:Image size="48" scale="2" resid="Icon96"/>
                    <bt:Image size="48" scale="3" resid="Icon144"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-80.png"/>
          <bt:Image id="Icon25" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-25.png"/>
          <bt:Image id="Icon48" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-48.png"/>
          <bt:Image id="Icon50" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-50.png"/>
          <bt:Image id="Icon64" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-64.png"/>
          <bt:Image id="Icon75" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-75.png"/>
          <bt:Image id="Icon96" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-96.png"/>
          <bt:Image id="Icon144" DefaultValue="https://klynovyj.github.io/mymonolith-addin/assets/icon-144.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="TaskpaneUrl" DefaultValue="https://klynovyj.github.io/mymonolith-addin/taskpane.html"/>
          <bt:Url id="SendRuntime.Url" DefaultValue="https://klynovyj.github.io/mymonolith-addin/send.html"/>
          <bt:Url id="SendRuntimeJs.Url" DefaultValue="https://klynovyj.github.io/mymonolith-addin/send-classic.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="MyMonolith"/>
          <bt:String id="BtnLabel" DefaultValue="Aufgaben"/>
          <bt:String id="ComposeBtnLabel" DefaultValue="Aufgabe wählen"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="BtnDesc" DefaultValue="Öffnet Ihre MyMonolith-Aufgaben in der Seitenleiste."/>
          <bt:String id="ComposeBtnDesc" DefaultValue="Wählt die MyMonolith-Aufgabe, an die diese Mail beim Senden gepostet wird."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
